{
  "version": 2,
  "buildCommand": "bun run vercel-build",
  "installCommand": "bun install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/v1/auth/login/route.ts": {
      "maxDuration": 30

// Study Vault — Prisma Schema
// Multi-tenant, SaaS-ready, RLS-compatible with Postgres when migrated.
// SQLite is used for local MVP development.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & IDENTITY
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      WorkspaceMember[]
  ownedWorkspaces Workspace[]
  auditLogs        AuditLog[]
  favorites        Favorite[]
  recentFiles      RecentFile[]
  notesCreated     Note[]              @relation("NoteCreatedBy")
  notesUpdated     Note[]              @relation("NoteUpdatedBy")
  foldersCreated   Folder[]            @relation("FolderCreatedBy")
  filesCreated     File[]              @relation("FileCreatedBy")
  filesUpdated     File[]              @relation("FileUpdatedBy")
  agentCredentials AgentCredential[]
  sessions         Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// MULTI-TENANCY
// ============================================================

model Workspace {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  ownerId           String
  plan              String   @default("FREE")
  storageLimitBytes Int      @default(1073741824) // 1 GB (MVP — switch to BigInt for higher tiers)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members          WorkspaceMember[]
  folders          Folder[]
  files            File[]
  notes            Note[]
  favorites        Favorite[]
  recentFiles      RecentFile[]
  auditLogs        AuditLog[]
  agentCredentials AgentCredential[]
  usageCounter     UsageCounter?
  integrations     Integration[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model UsageCounter {
  workspaceId       String   @id
  storageUsedBytes  Int      @default(0)
  filesCount        Int      @default(0)
  foldersCount      Int      @default(0)
  notesCount        Int      @default(0)
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ============================================================
// FILE MANAGER DOMAIN
// ============================================================

model Folder {
  id          String    @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  path        String    // materialized path, e.g. "/Concurso/Direito"
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderHierarchy")
  files     File[]
  notes     Note[]
  creator   User      @relation("FolderCreatedBy", fields: [createdBy], references: [id])

  @@index([workspaceId, parentId])
  @@index([workspaceId, path])
  @@index([deletedAt])
}

model File {
  id            String    @id @default(cuid())
  workspaceId   String
  folderId      String?
  name          String
  originalName  String
  storagePath   String    // server-generated, never client-controlled
  mimeType      String
  extension     String
  sizeBytes     Int
  checksum      String?
  version       Int       @default(1)
  metadata      String    // JSON string (SQLite has no JSONB)
  createdBy     String
  updatedBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator   User      @relation("FileCreatedBy", fields: [createdBy], references: [id])
  updater   User      @relation("FileUpdatedBy", fields: [updatedBy], references: [id])
  versions  FileVersion[]
  favorites Favorite[]
  recent    RecentFile[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, extension])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, name])
}

model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  version     Int
  storagePath String
  sizeBytes   Int
  checksum    String?
  createdBy   String
  createdAt   DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, version])
}

model Favorite {
  id          String   @id @default(cuid())
  workspaceId String
  fileId      String
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fileId, userId])
  @@index([workspaceId, userId])
}

model RecentFile {
  id          String   @id @default(cuid())
  workspaceId String
  fileId      String
  userId      String
  accessedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fileId, userId])
  @@index([workspaceId, userId, accessedAt])
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  folderId    String?
  title       String
  content     String    // Markdown by default
  format      String    @default("markdown")
  tags        String   @default("[]") // JSON array
  createdBy   String
  updatedBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator   User      @relation("NoteCreatedBy", fields: [createdBy], references: [id])
  updater   User      @relation("NoteUpdatedBy", fields: [updatedBy], references: [id])

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, title])
}

// ============================================================
// SYNC (OBSIDIAN FOUNDATION)
// ============================================================

model SyncDevice {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  deviceType  String   // pc | mobile | tablet
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  operations SyncOperation[]

  @@index([workspaceId])
}

model SyncOperation {
  id          String   @id @default(cuid())
  workspaceId String
  deviceId    String
  resourceType String // file | note | folder
  resourceId   String
  state       String   // SYNCED | PENDING_UPLOAD | PENDING_DOWNLOAD | CONFLICT | DELETED
  localVersion Int    @default(0)
  remoteVersion Int    @default(0)
  payload     String   // JSON metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device SyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
}

model Integration {
  id          String   @id @default(cuid())
  workspaceId String
  type       String   // obsidian | jarvis | openai | ...
  config     String   // JSON
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  actorType    String   // USER | AGENT | SYSTEM
  actorId      String?
  actorName    String
  action       String   // UPLOAD_FILE | DELETE_FILE | JARVIS_SEARCH_FILES | ...
  resourceType String?
  resourceId   String?
  requestId    String
  metadata     String   // JSON
  outcome      String   @default("SUCCESS") // SUCCESS | DENIED | ERROR
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)


  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@index([requestId])
}

// ============================================================
// JARVIS / AGENT CREDENTIALS
// ============================================================

model AgentCredential {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String    // friendly name, e.g. "JARVIS Production"
  tokenHash     String    // sha256 of api key
  tokenPrefix   String    // first 12 chars for display
  scopes        String    // JSON array of scope strings
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([tokenHash])
  @@index([workspaceId])
}

// ============================================================
// SaaS FOUNDATION (not active in MVP)
// ============================================================

model Plan {
  id                String  @id @default(cuid())
  name              String  @unique
  storageLimitBytes Int
  priceMonthlyCents Int     @default(0)
  features          String  // JSON
}

model Subscription {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  planId          String
  status          String   @default("ACTIVE")
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

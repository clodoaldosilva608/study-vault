# Study Vault — Environment Variables

# Database (Prisma). On Vercel serverless, default is /tmp/study-vault.db (ephemeral).
# For production, set this to a managed Postgres connection string.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Storage root for the local filesystem adapter.
# On Vercel, default is /tmp/study-vault-storage (ephemeral — use Vercel Blob for production).
STORAGE_ROOT=/home/z/my-project/storage

# JWT secret for session tokens. Set a long random string in production.
JWT_SECRET=study-vault-demo-jwt-secret-please-override-in-production-0123456789

# Optional seed user (used by scripts/seed.ts)
SEED_EMAIL=clodoaldo608@gmail.com
SEED_PASSWORD=88677488
SEED_NAME=Clodoaldo
